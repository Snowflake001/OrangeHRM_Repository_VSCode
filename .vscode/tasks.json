{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: Clean Compile",
            "type": "shell",
            "command": "mvn",
            "args": ["clean", "compile"],
            "problemMatcher": ["$java"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false
            }
        },
        {
            "label": "Maven: Run Tests",
            "type": "shell",
            "command": "mvn",
            "args": ["clean", "test"],
            "problemMatcher": ["$javaTest"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "Maven: Package",
            "type": "shell",
            "command": "mvn",
            "args": ["clean", "package"],
            "problemMatcher": ["$java"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false
            }
        },
        {
            "label": "Maven: Run SampleWebTest",
            "type": "shell",
            "command": "mvn",
            "args": ["-Dtest=SampleWebTest", "test"],
            "problemMatcher": ["$javaTest"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        }
    ]
}
